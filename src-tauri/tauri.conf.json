{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeFlow",
  "version": "0.1.0",
  "identifier": "dev.tdvorak.freeflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "FreeFlow",
        "width": 340,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focusable": false
      },
      {
        "label": "main",
        "title": "FreeFlow",
        "width": 960,
        "height": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["../sidecar/dist/whisper-sidecar"]
  }
}
